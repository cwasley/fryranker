{
  "name": "fryranker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/setup-db.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:setup": "tsx --env-file=.env.local scripts/setup-db.ts",
    "db:setup:prod": "tsx --env-file=.env.local scripts/setup-db.ts --prod",
    "spots": "tsx --env-file=.env.local scripts/spots.ts",
    "spots:prod": "tsx --env-file=.env.local scripts/spots.ts --prod"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/analytics": "^2",
    "@vercel/speed-insights": "^2",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10",
    "prettier": "^3",
    "tsx": "^4",
    "typescript": "~6.0"
  }
}
